<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipIconVisible">false</item>
        <item name="chipStrokeColor">@color/bg_surface</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@color/accent_glow</item>
    </style>

    <style name="Widget.App.ToggleButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">100dp</item>
    </style>

    <style name="CustomCalendarView" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorAccent">@color/accent_amber</item>
        <item name="android:colorAccent">@color/accent_amber</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
